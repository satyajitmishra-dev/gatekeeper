spring.application.name=api-management-service

server.port=8081

info.app.name=API Management Service
info.app.description=Custom API Management for configuration routes

spring.datasource.url=jdbc:mysql://localhost:3306/gatekeeper-api-management
spring.datasource.username=root
spring.datasource.password=your_db_password_here

spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
